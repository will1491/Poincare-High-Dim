# Ignore everything that is not part of the lean-eval submission workspace.
/*

# whitelist: trusted benchmark files, the solver-owned submission, and repository metadata
!/.gitignore
!/LICENSE
!/.github/
!/Challenge.lean
!/Solution.lean
!/Submission.lean
!/Submission/
!/WorkspaceTest.lean
!/config.json
!/holes.json
!/lakefile.toml
!/lake-manifest.json
!/lean-toolchain
!/docs/

# Local reference material is not part of the submission.
/docs/references/

# build artifacts and OS files anywhere
.lake/
.DS_Store
**/.DS_Store
